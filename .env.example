# Copy to .env and configure for your environment:
#   cp .env.example .env

# --- Application ---
OPENAI_API_KEY=

# --- ERP HTTP service (local process) ---
ERP_HOST=0.0.0.0
ERP_PORT=8000
ERP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///ledger.db

# --- Temporal (local process) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=transaction-tagging-queue

# --- Docker Compose overrides ---
# When using: docker compose -f docker/compose.yml up
# TEMPORAL_ADDRESS=temporal:7233
# DATABASE_URL=sqlite:////data/ledger.db
